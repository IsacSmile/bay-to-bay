datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model SiteSettings {
  id                String   @id @default("default")
  siteName          String   @default("Bay to Bay Express Inc.")
  announcementItems String[] @default(["NORTHERN ONTARIO ROUTES", "NORTH BAY TO HEARST", "TWICE-WEEKLY SERVICE OPTIONS"])
  updatedAt         DateTime @updatedAt
}

model ContactDetails {
  id        String   @id @default("default")
  phone     String   @default("705-978-3001")
  email     String?  @default("info@baytobayexpress.ca")
  updatedAt DateTime @updatedAt
}

model HeroContent {
  id                 String   @id @default("default")
  eyebrowLabel       String   @default("NORTHERN ONTARIO COURIER SERVICE")
  pillBadge          String   @default("HIGHWAY 11 CORRIDOR")
  headingLine1       String   @default("Reliable.")
  headingLine2       String   @default("Dedicated.")
  headingLine3Accent String   @default("Delivered.")
  subtext            String   @default("Small goods delivery across Northern Ontario.")
  description        String   @default("Dedicated and scheduled delivery solutions connecting North Bay, Kirkland Lake, Timmins, Cochrane, Kapuskasing, Hearst, and Longlac.")
  disclaimer         String?  @default("*Timing subject to route and location conditions.")
  featurePills       Json     @default("[{\"icon\":\"clock\",\"label\":\"12-hour options*\"},{\"icon\":\"truck\",\"label\":\"Twice-weekly routes\"},{\"icon\":\"package\",\"label\":\"Small goods specialists\"}]")
  updatedAt          DateTime @updatedAt
}

model HeroRoute {
  id         String          @id @default("default")
  label      String          @default("SPECIAL ROUTE")
  title      String          @default("North Bay → Hearst")
  duration   String          @default("12h")
  footerLead String          @default("Scheduled with reliability.")
  footerDesc String          @default("Ask about your route, recurring pickup, or dedicated run.")
  stops      HeroRouteStop[]
  updatedAt  DateTime        @updatedAt
}

model HeroRouteStop {
  id         String    @id @default(uuid())
  routeId    String
  route      HeroRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  stopNumber String
  name       String
  isStart    Boolean   @default(false)
  isEnd      Boolean   @default(false)
  order      Int       @default(0)
  xPercent   Float?    @default(0)
  yPercent   Float?    @default(0)
}

model ServiceAreaContent {
  id              String   @id @default("default")
  eyebrow         String   @default("SERVICE AREA")
  headingPrimary  String   @default("Connecting Northern Ontario.")
  headingAccent   String   @default("Delivering what matters.")
  description     String   @default("Our route knowledge is regional by design. We connect communities across Northern Ontario with small-goods transportation, scheduled service, and delivery arrangements that work for local businesses.")
  cardTitle       String   @default("Local knowledge. Regional reach.")
  cardDescription String   @default("North Bay to Hearst, with key stops in between.")
  badgeText       String   @default("Scheduled regional route")
  updatedAt       DateTime @updatedAt
}

model ThemeSettings {
  id              String   @id @default("default")
  snowfallEnabled Boolean  @default(true)
  updatedAt       DateTime @updatedAt
}

model ServicesSectionContent {
  id             String   @id @default("default")
  eyebrow        String   @default("DELIVERY SOLUTIONS")
  headingPrimary String   @default("Built around the way")
  headingAccent  String   @default("your business moves.")
  description    String   @default("From pharmacy supplies to legal documents, our focus is simple: dependable small-goods delivery that fits the route, the schedule, and the shipment requirements.")
  updatedAt      DateTime @updatedAt
}

model ServiceItem {
  id          String   @id @default(uuid())
  title       String
  description String
  icon        String   @default("package")
  order       Int      @default(0)
  isPriority  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BusinessSolutionsContent {
  id             String   @id @default("default")
  eyebrow        String   @default("BUSINESS SOLUTIONS")
  headingPrimary String   @default("More than a delivery.")
  headingAccent  String   @default("A logistics partner.")
  description    String   @default("Businesses need transportation they can count on. We provide scheduled and dedicated delivery solutions designed to help Northern Ontario businesses move small goods efficiently between communities.")
  briefText      String   @default("Choose a recurring route, direct run, or a custom arrangement that fits your locations.")
  ctaText        String   @default("Discuss your business needs")
  updatedAt      DateTime @updatedAt
}

model WhoWeServeContent {
  id             String   @id @default("default")
  eyebrow        String   @default("WHO WE SERVE")
  headingPrimary String   @default("Built for")
  headingAccent  String   @default("Northern Ontario businesses.")
  description    String   @default("Need a recurring delivery route? Let's talk through the pickup, destination, frequency, and service requirements.")
  ctaText        String   @default("Request a business quote")
  updatedAt      DateTime @updatedAt
}

model IndustryTag {
  id        String   @id @default(uuid())
  label     String
  icon      String   @default("building-2")
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WhyUsContent {
  id             String   @id @default("default")
  eyebrow        String   @default("WHY BAY TO BAY")
  headingPrimary String   @default("A clearer way to")
  headingAccent  String   @default("move what matters.")
  tagline        String   @default("REGIONAL FOCUS · LOCAL KNOWLEDGE")
  updatedAt      DateTime @updatedAt
}

model ReasonItem {
  id          String   @id @default(uuid())
  title       String
  description String
  icon        String   @default("package")
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model HowItWorksContent {
  id             String   @id @default("default")
  eyebrow        String   @default("HOW IT WORKS")
  headingPrimary String   @default("Simple.")
  headingAccent  String   @default("Reliable. Delivered.")
  description    String   @default("A straightforward process from first conversation to final drop-off.")
  ctaText        String   @default("Start your delivery →")
  updatedAt      DateTime @updatedAt
}

model HowItWorksStep {
  id          String   @id @default(uuid())
  title       String
  description String
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model QuoteFormContent {
  id               String   @id @default("default")
  eyebrow          String   @default("REQUEST A QUOTE")
  headingPrimary   String   @default("Tell us the route.")
  headingAccent    String   @default("We'll help plan the run.")
  description      String   @default("Share a few details about your pickup, delivery, and shipment. We'll contact you to discuss the right service arrangement.")
  serviceNoteLead  String   @default("Service note:")
  serviceNoteText  String   @default("12-hour options and medical/pharmacy supply delivery are subject to route, pickup time, shipment, handling, and service requirements.")
  disclaimer       String   @default("No price calculator is shown. We'll review the route and shipment details with you directly.")
  updatedAt        DateTime @updatedAt
}

model QuoteRequest {
  id               String   @id @default(uuid())
  fullName         String
  companyName      String?
  phone            String
  email            String
  pickupLocation   String
  deliveryLocation String
  preferredDate    String
  frequency        String   @default("One time")
  packageCount     String?
  approxWeight     String?
  typeOfGoods      String?
  additionalInfo   String?
  status           String   @default("new")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model AboutContent {
  id               String   @id @default("default")
  eyebrow          String   @default("ABOUT BAY TO BAY")
  headingPrimary   String   @default("Local routes.")
  headingAccent    String   @default("Professional service.")
  description      String   @default("Bay to Bay Express Inc. is a Northern Ontario delivery and logistics company focused on reliable small-goods transportation and dedicated business delivery solutions. We connect communities across Northern Ontario through scheduled, recurring, and customized delivery services designed around the needs of local businesses and organizations.")
  quoteText        String   @default("Reliable. Dedicated. Delivered.")
  quoteDescription String   @default("A clear promise about how we approach scheduled, dedicated, and small-goods delivery across Northern Ontario.")
  attribution      String   @default("BAY TO BAY EXPRESS INC.")
  updatedAt        DateTime @updatedAt
}

model AboutTagPill {
  id        String   @id @default(uuid())
  label     String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FaqContent {
  id             String   @id @default("default")
  eyebrow        String   @default("COMMON QUESTIONS")
  headingPrimary String   @default("Good to know")
  headingAccent  String   @default("before you book.")
  description    String   @default("Clear details help us plan the right route and service arrangement for your shipment.")
  updatedAt      DateTime @updatedAt
}

model FaqItem {
  id        String   @id @default(uuid())
  question  String
  answer    String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

